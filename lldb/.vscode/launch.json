{
    "version": "0.2.0",
    "configurations": [
        // ============================================
        // EXISTING CONFIGURATIONS
        // ============================================
        {
            "type": "lldb",
            "request": "launch",
            "name": "🚀 GNUstep/libobjc2 - Debug",
            "program": "c:/tools/msys64/home/kardjali/code/llvm-project/lldb/examples/simple_test.exe",
            "args": [],
            "cwd": "c:/tools/msys64/home/kardjali/code/llvm-project/lldb",
            "preLaunchTask": "build-one-example",
            "console": "integratedTerminal",
            "initCommands": [
                // "log enable lldb formatters",
                "b main",
                // "settings set target.language objc",
                // "type category enable gnustep/libobjc2",
                "settings set target.process.stop-on-sharedlibrary-events false",
                "settings set target.prefer-dynamic-value no-dynamic-values"
            ],
            "env": {
                "PATH": "/ucrt64/lib:/ucrt64/bin:c:/tools/msys64/home/kardjali/code/llvm-project/build/bin"
            }
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "🔍 Debug with Full Logging",
            "program": "${workspaceFolder}/examples/custom_class_test",
            "args": [],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "build-all-examples",
            "initCommands": [
                "log enable -f ${workspaceFolder}/lldb_full.log -v lldb all",
                "log enable -f ${workspaceFolder}/lldb_language.log -v lldb language",
                "log enable -f ${workspaceFolder}/lldb_types.log lldb types",
                "log enable -f ${workspaceFolder}/lldb_formatters.log lldb formatters",
                "settings set target.process.stop-on-sharedlibrary-events false",
                "script print('🔍 Full LLDB logging enabled to files:')",
                "script print('   - lldb_full.log (all categories)')",
                "script print('   - lldb_language.log (language runtime)')",
                "script print('   - lldb_types.log (type system)')",
                "script print('   - lldb_formatters.log (data formatters)')"
            ],
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src:${env:PYTHONPATH}",
                "LD_LIBRARY_PATH": "${workspaceFolder}/../build/lib",
                "OBJC_DEBUG_LOG": "1",
                "GNUSTEP_MAKEFILES": "/usr/local/share/GNUstep/Makefiles",
                "PATH": "${workspaceFolder}/../build/bin:${env:PATH}"
            }
        },
        // ============================================
        // FOUNDATION FORMATTER TESTS
        // ============================================
        {
            "type": "lldb",
            "request": "launch",
            "name": "📚 Test All Foundation Formatters",
            "program": "${workspaceFolder}/examples/foundation_test_simple",
            "args": [],
            "cwd": "${workspaceFolder}/examples",
            "preLaunchTask": "build-all-examples",
            "initCommands": [
                // "log enable lldb formatters",
                "settings set target.language objc",
                "b main",
                "settings set target.process.stop-on-sharedlibrary-events false",
                "settings set target.prefer-dynamic-value no-dynamic-values"
            ],
            "env": {
                "LD_LIBRARY_PATH": "/usr/local/lib:${workspaceFolder}/../build/lib",
                "PATH": "${workspaceFolder}/../build/bin:${env:PATH}"
            }
        },
        // ============================================
        // UNIT TEST SUITE
        // ============================================
        {
            "type": "cppdbg",
            "request": "launch",
            "name": "🧪 Run Unit Tests",
            "program": "${workspaceFolder}/../build/tools/lldb/unittests/Language/ObjC/GNUstep/LanguageObjCGNUstepTests",
            "args": [
                "--gtest_brief=1",
                "--gtest_filter=*"
            ],
            "cwd": "${workspaceFolder}/../build/tools/lldb/unittests/Language/ObjC/GNUstep",
            "preLaunchTask": "build-all-examples",
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "environment": [
                {
                    "name": "LD_LIBRARY_PATH",
                    "value": "${workspaceFolder}/../build/lib:/usr/local/lib:${env:LD_LIBRARY_PATH}"
                }
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        // ============================================
        // API INTEGRATION TESTS
        // ============================================
        {
            "type": "debugpy",
            "name": "🔄 Run API Integration Tests",
            "request": "launch",
            "program": "${workspaceFolder}/../llvm/utils/lit/lit.py",
            "args": [
                "-v",
                "--filter=gnustep",
                "--param=dotest-args=--compiler=${workspaceFolder}/../build/bin/clang",
                "."
            ],
            "cwd": "${workspaceFolder}/../build/tools/lldb/test/API",
            "preLaunchTask": "build-all-examples",
            "env": {
                "LD_LIBRARY_PATH": "/usr/local/lib:${workspaceFolder}/../build/lib:${workspaceFolder}/../build",
                "PATH": "${workspaceFolder}/../build/bin:${workspaceFolder}/../build/bin:${env:PATH}",
                "LLDB_TEST": "${workspaceFolder}/../build/bin/lldb"
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "type": "debugpy",
            "name": "🔍 Debug API Integration Tests",
            "request": "launch",
            "program": "${workspaceFolder}/../llvm/utils/lit/lit.py",
            "args": [
                "-vv",
                "--show-unsupported",
                "--show-xfail",
                "--filter=gnustep",
                "--param=dotest-args=--compiler=${workspaceFolder}/../build/bin/clang --verbose",
                "."
            ],
            "cwd": "${workspaceFolder}/../build/tools/lldb/test/API",
            "preLaunchTask": "build-all-examples",
            "env": {
                "LD_LIBRARY_PATH": "/usr/local/lib:${workspaceFolder}/../build/lib:${workspaceFolder}/../build/lib",
                "PATH": "${workspaceFolder}/../build/bin:${workspaceFolder}/../build/bin:${env:PATH}",
                "LLDB_TEST": "${workspaceFolder}/../build/bin/lldb"
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "panel": "shared"
            }
        },
