        "/ucrt64/include",
        "/ucrt64/include/GNUstepBase", 
        "/ucrt64/include/Foundation",
        "${workspaceFolder}/../build/include"
    ],
    "C_Cpp.default.defines": [
        "GNUSTEP",
        "GNUSTEP_BASE_LIBRARY=1",
        "HAVE_MODE_T",
