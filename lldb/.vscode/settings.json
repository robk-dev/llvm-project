    ],
    "C_Cpp.default.compilerPath": "/ucrt64/bin/clang.exe",
    "C_Cpp.default.cStandard": "gnu11",
    "C_Cpp.default.cppStandard": "gnu++17",
    "python.defaultInterpreterPath": "/usr/bin/python3"
