{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "configure-full-development (CMake)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S", "${workspaceFolder}/../llvm",
                "-B", "${workspaceFolder}/../build",
                "-G", "Ninja",
                "-DCMAKE_BUILD_TYPE=Debug",
                "-DLLVM_ENABLE_PROJECTS=clang;lldb",
                "-DLLVM_ENABLE_ASSERTIONS=ON",
                "-DLLDB_ENABLE_PYTHON=OFF",
                "-DCMAKE_C_COMPILER=clang",
                "-DCMAKE_CXX_COMPILER=clang++",
                "-DLLVM_USE_LINKER=lld"
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "group": "build",
            "problemMatcher": "$gcc"
        },
        {
            "label": "build-plugin",
            "type": "shell",
            "command": "ninja",
            "args": [
                "lldbPluginGNUstepObjCRuntime"
            ],
            "options": {
                "cwd": "${workspaceFolder}/../build"
            },
            "group": "build",
            "problemMatcher": "$gcc"
        },
        {
            "label": "examples: configure (CMake)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S", "${workspaceFolder}/examples",
                "-B", "${workspaceFolder}/examples/build-examples",
                "-DCMAKE_OBJC_COMPILER=clang"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build"
        },
        {
            "label": "examples: build all (CMake)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "${workspaceFolder}/examples/build-examples",
                "-j${config:numberOfJobs}"
            ],
            "dependsOn": ["examples: configure (CMake)", "build-full-development"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "examples: build one (CMake)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "${workspaceFolder}/examples/build-examples",
                "--target", "${input:exampleName}",
                "-j${config:numberOfJobs}"
            ],
            "dependsOn": ["examples: configure (CMake)", "build-full-development"],
            "group": "build",
            "problemMatcher": "$gcc"
        },
        {
            "label": "examples: debug one (CMake)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "${workspaceFolder}/examples/build-examples",
                "--target", "debug-${input:exampleName}",
                "-j1"
            ],
            "dependsOn": ["examples: configure (CMake)", "examples: build one (CMake)"],
            "group": "build",
            "problemMatcher": "$gcc"
        },
        {
            "label": "build-gnustep-examples",
            "type": "shell", 
            "command": "cmake",
            "args": [
                "--build", "${workspaceFolder}/examples/objc/gnustep/build",
                "-j$(nproc)"
            ],
            "dependsOn": ["configure-gnustep-examples"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "configure-gnustep-examples",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S", "${workspaceFolder}/examples/objc/gnustep",
                "-B", "${workspaceFolder}/examples/objc/gnustep/build",
                "-G", "Ninja",
                "-DCMAKE_BUILD_TYPE=Debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}/examples/objc/gnustep"
            },
            "group": "build",
            "problemMatcher": "$gcc"
        },
        {
            "label": "build-all-examples-linux",
            "type": "shell",
            "command": "make",
            "args": ["all"],
            "options": {
                "cwd": "${workspaceFolder}/examples"
            },
            // "dependsOn": ["build-plugin"],
            "group": "build",
            "problemMatcher": "$gcc"
        },
        {
            "label": "build-all-examples-windows",
            "type": "shell",
            "command": "make",
            "args": [
                "all"
            ],
            "options": {
                "cwd": "${workspaceFolder}/examples",
                "env": {
                    "PATH": "/ucrt64/lib:/ucrt64/bin:${workspaceFolder}/../build/bin:${env:PATH}"
                }
            },
            "dependsOn": [
                "build-full-development"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "build-full-development",
            "type": "shell",
            "dependsOn": [
                "configure-full-development (CMake)",
                "build-plugin"
            ],
            "command": "ninja",
            "args": [
                "lldb",
                "lldb-server"
            ],
            "options": {
                "cwd": "${workspaceFolder}/../build"
            },
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": "$gcc"
        }
    ]
    ,
    "inputs": [
        {
            "id": "exampleName",
            "type": "pickString",
            "description": "Select example to build",
            "options": [
                "simple_test",
                "custom_class_test",
                "foundation_test",
                "string_test",
                "test_nsstring_formatter",
                "test_nsnumber_formatter",
                "array_test",
                "simple_array_test",
                "test_nsnumber_comprehensive",
                "test_nsarray_comprehensive",
                "dictionary_test",
                "nsset_test",
                "test_collections_formatter",
                "test_method_enum",
                "test_indexset",
                "test_decimalnumber",
                "test_characterset",
                "test_data_url_uuid",
                "test_userdefaults",
                "test_tagged_pointers",
                "test_stepping_trampoline",
                "test_object_checker",
                "test_exception_resolver"
            ]
        }
    ]
}