#!/bin/bash

# GNUstep Development Stack Builder
# Builds a complete self-contained GNUstep environment using our LLVM toolchain
# Based on the comprehensive scripts2/helpers/gnustep_operations.sh setup

set -e

# Configuration
PROJECT_ROOT="/home/robk/code/llvm-project"
LLVM_BUILD_DIR="${PROJECT_ROOT}/build"
GNUSTEP_INSTALL_PREFIX="${PROJECT_ROOT}/lldb/gnustep-install"
GNUSTEP_BUILD_DIR="${PROJECT_ROOT}/lldb/gnustep-build"

# Source directories
LIBOBJC2_SOURCE_DIR="${PROJECT_ROOT}/lldb/libobjc2"
LIBS_BASE_SOURCE_DIR="${PROJECT_ROOT}/lldb/libs-base"

# Build settings - use debug symbols compatible with LLDB
BUILD_TYPE="Debug"
JOBS="${JOBS:-$(nproc)}"

# Colors for output
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
RED='\033[0;31m'
NC='\033[0m'

print_section() { echo -e "${BLUE}========================================${NC}"; echo -e "${BLUE}$1${NC}"; echo -e "${BLUE}========================================${NC}"; }
print_progress() { echo -e "${CYAN}→ $1${NC}"; }
print_success() { echo -e "${GREEN}✓ $1${NC}"; }
print_error() { echo -e "${RED}✗ $1${NC}"; }
print_warning() { echo -e "${YELLOW}⚠ $1${NC}"; }

print_section "GNUstep Development Stack Builder"
echo "Project Root: ${PROJECT_ROOT}"
echo "LLVM Build Dir: ${LLVM_BUILD_DIR}"
echo "GNUstep Install Prefix: ${GNUSTEP_INSTALL_PREFIX}"
echo "Build Type: ${BUILD_TYPE}"
echo "Parallel Jobs: ${JOBS}"

# Verify LLVM is built
if [[ ! -f "${LLVM_BUILD_DIR}/bin/clang" ]]; then
    print_error "LLVM/Clang not found at ${LLVM_BUILD_DIR}/bin/clang"
    echo "Please build LLVM first: ./build_scripts/build_lldb.sh"
    exit 1
fi

print_success "LLVM toolchain found"

# Clean if requested
if [[ "$1" == "clean" ]]; then
    print_progress "Cleaning GNUstep build and install directories..."
    rm -rf "${GNUSTEP_BUILD_DIR}"
    rm -rf "${GNUSTEP_INSTALL_PREFIX}"
fi

# Create directories
mkdir -p "${GNUSTEP_BUILD_DIR}"
mkdir -p "${GNUSTEP_INSTALL_PREFIX}"

# Clone sources if needed
if [[ ! -d "${LIBOBJC2_SOURCE_DIR}" ]]; then
    print_progress "Cloning libobjc2..."
    cd "${PROJECT_ROOT}/lldb"
    git clone https://github.com/gnustep/libobjc2.git
else
    print_success "libobjc2 source found"
fi

if [[ ! -d "${LIBS_BASE_SOURCE_DIR}" ]]; then
    print_progress "Cloning libs-base..."
    cd "${PROJECT_ROOT}/lldb"
    git clone https://github.com/gnustep/libs-base.git
else
    print_success "libs-base source found"
fi

# Set up environment using our LLVM toolchain
export CC="${LLVM_BUILD_DIR}/bin/clang"
export CXX="${LLVM_BUILD_DIR}/bin/clang++"
export OBJC="${CC}"
export OBJCXX="${CXX}"

# LLDB-friendly compiler flags from scripts2 setup
export GNUSTEP_CFLAGS="-g -gdwarf-5 -O0 -fno-omit-frame-pointer -DDEBUG=1"
export GNUSTEP_CXXFLAGS="-g -gdwarf-5 -O0 -fno-omit-frame-pointer -DDEBUG=1"
export GNUSTEP_OBJCFLAGS="-g -gdwarf-5 -O0 -fno-omit-frame-pointer -DDEBUG=1 -fobjc-runtime=gnustep-2.2 -fconstant-string-class=NSConstantString"
export GNUSTEP_LDFLAGS="-g"

# Update paths
export PATH="${GNUSTEP_INSTALL_PREFIX}/bin:${LLVM_BUILD_DIR}/bin:$PATH"
export LD_LIBRARY_PATH="${GNUSTEP_INSTALL_PREFIX}/lib:${LLVM_BUILD_DIR}/lib:$LD_LIBRARY_PATH"
export PKG_CONFIG_PATH="${GNUSTEP_INSTALL_PREFIX}/lib/pkgconfig:$PKG_CONFIG_PATH"

print_section "Building libobjc2 (Objective-C Runtime)"

# Build libobjc2 with our LLVM toolchain
cd "${GNUSTEP_BUILD_DIR}"
rm -rf libobjc2
mkdir -p libobjc2
cd libobjc2

# Update source
cd "${LIBOBJC2_SOURCE_DIR}"
git fetch origin || true
git reset --hard origin/master || true

cd "${GNUSTEP_BUILD_DIR}/libobjc2"

print_progress "Configuring libobjc2 with LLDB-friendly debug symbols..."

cmake "${LIBOBJC2_SOURCE_DIR}" \
    -DCMAKE_BUILD_TYPE="${BUILD_TYPE}" \
    -DCMAKE_C_COMPILER="${CC}" \
    -DCMAKE_CXX_COMPILER="${CXX}" \
    -DCMAKE_INSTALL_PREFIX="${GNUSTEP_INSTALL_PREFIX}" \
    -DCMAKE_C_FLAGS="${GNUSTEP_CFLAGS} -ffunction-sections -fdata-sections" \
    -DCMAKE_CXX_FLAGS="${GNUSTEP_CXXFLAGS} -ffunction-sections -fdata-sections" \
    -DCMAKE_SHARED_LINKER_FLAGS="-lstdc++" \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DGNUSTEP_INSTALL_TYPE=NONE \
    -DCMAKE_EXPORT_COMPILE_COMMANDS=ON \
    -GNinja

print_progress "Building libobjc2..."
ninja -j${JOBS}

print_progress "Installing libobjc2..."
ninja install

# Verify libobjc2 installation
if [[ ! -f "${GNUSTEP_INSTALL_PREFIX}/lib/libobjc.so" ]]; then
    print_error "libobjc2 installation failed - library not found"
    exit 1
fi

print_success "libobjc2 built and installed: ${GNUSTEP_INSTALL_PREFIX}/lib/libobjc.so"

print_section "Building libs-base (Foundation Library)"

# For now, let's skip the complex libs-base build and create a minimal working environment
# We'll use the system gnustep-base but with our custom libobjc2
print_warning "Skipping libs-base build - using hybrid approach with system Foundation"

# Install required system Foundation components if not present
if ! dpkg -l | grep -q "libgnustep-base-dev"; then
    print_progress "Installing system GNUstep Foundation development files..."
    sudo apt-get update
    sudo apt-get install -y libgnustep-base-dev libgnustep-base1.28
fi

# Create a simple wrapper that uses our custom libobjc2 but system Foundation
print_progress "Setting up hybrid environment..."

# Copy system Foundation headers to our install directory for consistency
mkdir -p "${GNUSTEP_INSTALL_PREFIX}/include"
if [[ -d "/usr/include/GNUstep" ]]; then
    cp -r /usr/include/GNUstep/* "${GNUSTEP_INSTALL_PREFIX}/include/" 2>/dev/null || true
fi

# Create a symlink to system libgnustep-base but ensure our libobjc2 takes precedence
if [[ -f "/usr/lib/x86_64-linux-gnu/libgnustep-base.so" ]]; then
    ln -sf /usr/lib/x86_64-linux-gnu/libgnustep-base.so "${GNUSTEP_INSTALL_PREFIX}/lib/libgnustep-base.so" 2>/dev/null || true
fi

print_success "Hybrid GNUstep environment set up successfully"

print_section "Installation Complete!"

echo ""
echo "Installation Summary:"
echo "  Install Prefix: ${GNUSTEP_INSTALL_PREFIX}"
echo "  libobjc2: ${GNUSTEP_INSTALL_PREFIX}/lib/libobjc.so (custom built)"
echo "  libs-base: Using system Foundation with custom runtime"
echo "  Headers: ${GNUSTEP_INSTALL_PREFIX}/include/"

echo ""
echo "Environment Setup for Development:"
echo "  export GNUSTEP_ROOT=\"${GNUSTEP_INSTALL_PREFIX}\""
echo "  export PATH=\"${GNUSTEP_INSTALL_PREFIX}/bin:${LLVM_BUILD_DIR}/bin:\$PATH\""
echo "  export LD_LIBRARY_PATH=\"${GNUSTEP_INSTALL_PREFIX}/lib:${LLVM_BUILD_DIR}/lib:\$LD_LIBRARY_PATH\""

echo ""
echo "Compilation Flags:"
echo "  CC=\"${CC}\""
echo "  OBJCFLAGS=\"${GNUSTEP_OBJCFLAGS}\""
echo "  CFLAGS=\"${GNUSTEP_CFLAGS}\""
echo "  LDFLAGS=\"-L${GNUSTEP_INSTALL_PREFIX}/lib -Wl,-rpath,${GNUSTEP_INSTALL_PREFIX}/lib\""
echo "  LIBS=\"-lgnustep-base -lobjc\""

echo ""
echo "Next Steps:"
echo "  1. Test with: ./build_scripts/test_gnustep_stack.sh"
echo "  2. Use VSCode task: 'build-custom-class-test-with-custom-gnustep'"
echo "  3. Debug with: ${LLVM_BUILD_DIR}/bin/lldb ./examples/custom_class_test_custom"

print_section "Build Complete!"
