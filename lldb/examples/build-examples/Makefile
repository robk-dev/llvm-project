debug-test_tagged_pointers: cmake_check_build_system
	$(MAKE) $(MAKESILENT) -f CMakeFiles/Makefile2 debug-test_tagged_pointers
.PHONY : debug-test_tagged_pointers

# fast build rule for target.
debug-test_tagged_pointers/fast:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/debug-test_tagged_pointers.dir/build.make CMakeFiles/debug-test_tagged_pointers.dir/build
.PHONY : debug-test_tagged_pointers/fast

