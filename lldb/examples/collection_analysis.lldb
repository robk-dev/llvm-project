#!/usr/bin/env lldb -s

file collection_formatter_analysis
b collection_formatter_analysis.m:50
run

# Check empty collections
expr emptyArray
expr emptyDict  
expr emptySet

# Check small collections (should show inline elements per GUIDANCE.md)
expr smallArray
expr smallDict
expr smallSet

# Check large collections (should truncate)
expr largeArray
expr largeDict

# Check nested collections
expr nestedArray
expr nestedDict

# Check mixed types
expr mixedArray
expr mixedDict

# Save output and exit
quit