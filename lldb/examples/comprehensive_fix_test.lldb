#!/usr/bin/env lldb -s

# Test the fix with multiple scenarios
file custom_class_test
breakpoint set -f custom_class_test.m -l 127
run

# Test 1: Custom class property (the original bug)
p account
p account._transactions

# Test 2: Direct array access (should work normally)
po fruits
p fruits

# Test 3: Dictionary access
po personInfo  
p personInfo

# Test 4: NSNumber access
po magicNumber
p magicNumber

continue
quit