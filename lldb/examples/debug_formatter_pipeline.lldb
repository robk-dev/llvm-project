# Debug script to trace LLDB formatter pipeline
# This will show us what formatters are actually being called
# and where the pipeline breaks down

# Enable comprehensive logging
log enable -f /tmp/lldb_formatters.log lldb data-formatters
log enable -f /tmp/lldb_types.log lldb types
log enable -f /tmp/lldb_expressions.log lldb expr

# Set breakpoint and run
b custom_class_test.m:127
run

# Test specific problematic cases to trace the pipeline
script print("=== TRACING NSNumber FORMATTER PIPELINE ===")
print magicNumber
po magicNumber

script print("=== TRACING DICTIONARY FORMATTER PIPELINE ===") 
print personInfo
po personInfo

script print("=== TRACING ARRAY ELEMENT ACCESS ===")
expression NSArray *skills = [personInfo objectForKey:@"skills"]
print skills
po skills

script print("=== EXAMINING DICTIONARY SYNTHETIC CHILDREN ===")
# See what synthetic children are created
frame variable -T personInfo
frame variable -R personInfo

script print("=== CHECKING INDIVIDUAL STRING OBJECTS ===")
# Try to access individual string objects and see their types
frame variable -T greeting2
po greeting2

quit