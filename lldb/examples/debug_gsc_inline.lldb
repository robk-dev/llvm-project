target create test_inline_string_formatter
breakpoint set -f test_inline_string_formatter.m -l 93
run
frame variable short1
frame variable medium1
frame variable unicode1
frame variable concat1
p (const char*)class_getName(object_getClass(short1))
p (const char*)class_getName(object_getClass(medium1))
p (const char*)class_getName(object_getClass(concat1))
quit