# Verbose debug script for GNUstep debugging
log enable lldb process
log enable lldb target
log enable lldb breakpoint
settings set target.prefer-dynamic-value run-target
settings set target.skip-prologue false
settings show

target create simple_test.exe
image list

# Set breakpoint and show details
breakpoint set --file simple_test.m --line 8
breakpoint list

# Try to run with process launch instead of run
process launch --stop-at-entry
