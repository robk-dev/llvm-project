#!/usr/bin/env lldb -s

# NSError formatter validation test
target create simple_error_test
run

# Check if process ran successfully (exit code 0 means NSError objects were created)
# Now let's examine the NSError formatter behavior

# List available type categories to confirm GNUstep formatters are loaded
type category list

# Test the formatters - this would normally show the NSError summary
# But since process exited, let's create a new run with breakpoints
quit