# Comprehensive Runtime Bridge Validation Test
# This script validates that the GNUstep runtime bridge is working correctly

file custom_class_test
b custom_class_test.m:125
run

echo "=== RUNTIME BRIDGE VALIDATION ==="

echo "\n1. Custom Class ISA Resolution Test"
po account
print account
frame variable account

echo "\n2. Foundation Class Testing"
po personInfo
po fruits  
po magicNumber
po currentTime

echo "\n3. Memory Layout Analysis"
p/x account
memory read -c 8 -f x account

echo "\n4. Nested Object Resolution"
po [account transactions]
po [account authorizedUsers]

echo "\n5. Class Hierarchy Testing"
expr (void*)object_getClass(account)
expr (void*)class_getSuperclass((void*)object_getClass(account))

echo "\n6. Tagged Pointer Testing"
po @42
po @"test"
po [NSDate date]

echo "=== TEST COMPLETE ==="
quit