#!/usr/bin/env lldb -S
# LLDB script for comprehensive Foundation formatter validation
# Run with: lldb -S test_all_foundation_formatters.lldb foundation_test_simple

# Set breakpoint at the comprehensive validation point
b foundation_test_simple.m:310

# Run the program
run

# Test all Foundation formatters systematically

# === STRING FORMATTERS ===
echo "=== TESTING STRING FORMATTERS ==="
po emptyString
po shortString  
po longString
po unicodeString
po mutableString
po nilString

# === NUMBER FORMATTERS ===
echo "\n=== TESTING NUMBER FORMATTERS ==="
po zeroNumber
po smallInt
po largeInt
po floatNumber
po doubleNumber
po boolYES
po boolNO
po negativeNumber
po nilNumber

# === ARRAY FORMATTERS ===
echo "\n=== TESTING ARRAY FORMATTERS ==="
po emptyArray
po singleElementArray
po smallArray
po mixedArray
po nestedArray
po mutableArray
po nilArray

# === DICTIONARY FORMATTERS ===
echo "\n=== TESTING DICTIONARY FORMATTERS ==="
po emptyDict
po singlePairDict
po smallDict
po nestedDict
po mutableDict
po nilDict

# === SET FORMATTERS ===
echo "\n=== TESTING SET FORMATTERS ==="
po emptySet
po singleElementSet
po smallSet
po mixedSet
po mutableSet
po nilSet

# === DATE FORMATTERS ===
echo "\n=== TESTING DATE FORMATTERS ==="
po now
po pastDate
po futureDate
po nilDate

# === DATA FORMATTERS ===
echo "\n=== TESTING DATA FORMATTERS ==="
po emptyData
po smallData
po binaryData
po mutableData
po nilData

# === UUID FORMATTERS ===
echo "\n=== TESTING UUID FORMATTERS ==="
po randomUUID
po zeroUUID
po nilUUID

# === URL FORMATTERS ===
echo "\n=== TESTING URL FORMATTERS ==="
po httpURL
po fileURL
po nilURL

# === ERROR FORMATTERS ===
echo "\n=== TESTING ERROR FORMATTERS ==="
po fileError
po customError
po nilError

# === INDEX SET FORMATTERS ===
echo "\n=== TESTING INDEX SET FORMATTERS ==="
po emptyIndexSet
po singleIndex
po rangeIndexSet
po mutableIndexSet
po nilIndexSet

# === DECIMAL NUMBER FORMATTERS ===
echo "\n=== TESTING DECIMAL NUMBER FORMATTERS ==="
po zero
po one
po pi
po negative
po nilDecimal

# === CHARACTER SET FORMATTERS ===
echo "\n=== TESTING CHARACTER SET FORMATTERS ==="
po letterCharSet
po digitCharSet
po customCharSet
po mutableCharSet
po nilCharSet

# === CUSTOM OBJECT TEST ===
echo "\n=== TESTING CUSTOM OBJECT FORMATTER ==="
po testObj

# === LARGE COLLECTION TESTS ===
echo "\n=== TESTING LARGE COLLECTION FORMATTERS ==="
po largeArray
po largeDict
po largeSet

# === NESTED COLLECTION TEST ===
echo "\n=== TESTING NESTED COLLECTION FORMATTERS ==="
po deeplyNested

# === SYNTHETIC CHILDREN TESTS ===
echo "\n=== TESTING SYNTHETIC CHILDREN PROVIDERS ==="
frame variable smallArray
frame variable smallDict
frame variable smallSet

# === PERFORMANCE TEST ===
echo "\n=== PERFORMANCE VALIDATION ==="
echo "All formatter tests completed"
echo "Check output above for proper formatting of all Foundation types"

# Continue execution
continue

quit