#!/usr/bin/env lldb
# Test various ways dates might show as hex

target create test_date_formatter

b test_date_formatter.m:46
run

# Direct object access
po currentTime
expr currentTime

# Dictionary access with objectForKey
expr [timeDict objectForKey:@"currentTime"]
po [timeDict objectForKey:@"currentTime"]

# Nested dictionary access
expr [[complexDict objectForKey:@"session"] objectForKey:@"expires"]

# Try valueForKeyPath
expr [complexDict valueForKeyPath:@"session.expires"]
po [complexDict valueForKeyPath:@"session.expires"]

# Check what raw memory access shows
x/8gx currentTime

# Check the object's isa
expr (void*)[currentTime class]

continue
quit