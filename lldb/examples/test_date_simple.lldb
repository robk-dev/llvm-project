#!/usr/bin/env lldb
# Simple test to check if the dates are showing as hex anywhere

target create test_date_formatter

b test_date_formatter.m:46
run

# Test simple cases first
po currentTime
po timeDict[@"currentTime"]

# Test the problematic nested case
po complexDict[@"session"][@"expires"]

# Check what happens with direct access
expr currentTime
expr timeDict[@"currentTime"]

continue
quit