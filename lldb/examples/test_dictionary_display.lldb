#!/usr/bin/lldb -x -s

# Test script for dictionary display formatters
# Run with: lldb -x -s test_dictionary_display.lldb

file test_dictionary_display

# Set breakpoint at the NSLog statements
b test_dictionary_display.m:37

# Run the program
run

# Test 1: Basic dictionary should show keys as names, not indices
po basicDict
# Expected: { name = "John Doe"; occupation = "Developer"; city = "San Francisco" }
# NOT: { [0] = "John Doe"; [1] = "Developer"; [2] = "San Francisco" }

# Test 2: Mixed dictionary with nested collections
po mixedDict
# Expected: Keys should be "string", "number", "array", "nested"
# Drill-down into nested collections should work

# Test 3: Mutable dictionary
po mutableDict
# Expected: Keys as names with proper values

# Test 4: Test drill-down into nested collections
frame variable nestedCollections
# Should be able to expand "users" array, "preferences" set, and "settings" dict

# Test child access
expr nestedCollections[@"users"]
# Should show the array

expr nestedCollections[@"settings"]
# Should show the nested dictionary

# Continue and exit
continue
quit