#!/usr/bin/env lldb -s
# Test script to evaluate current state of expression evaluation in GNUstep LLDB bridge

file custom_class_test
breakpoint set -f custom_class_test.m -l 250
run

# Test basic po commands on various object types when hit breakpoint
po account
po personInfo  
po fruits
po magicNumber
po currentTime

# Test expression evaluation with timeout
expr -T 2.0 -- (NSString*)[(id)account description]
expr -T 2.0 -- [account balance]
expr -T 2.0 -- [fruits objectAtIndex:0]

# Test edge cases
po nilString
po emptyArray

# Test CreateObjectChecker functionality
expr -T 1.0 -- [account respondsToSelector:@selector(balance)]

continue
quit