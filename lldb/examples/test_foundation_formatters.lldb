# LLDB script to test Foundation formatters
file foundation_debug_test

# Set breakpoint after objects are created but before getchar
breakpoint set --file foundation_debug_test.m --line 40

# Run the program
run

# When stopped, test all the Foundation formatters
print currentDate
print pastDate
print futureDate
print specificDate
print nilDate

print httpURL  
print fileURL
print nilURL

print smallData
print emptyData
print nilData

print randomUUID
print specificUUID
print nilUUID

print simpleError
print nilError

# Test po command (which uses our formatters)
po currentDate
po httpURL
po smallData  
po randomUUID
po simpleError

# Continue execution
continue