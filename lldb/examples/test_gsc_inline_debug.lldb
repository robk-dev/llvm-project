target create test_inline_string_formatter
breakpoint set -f test_inline_string_formatter.m -l 93
run
frame variable -T -L concat1
p (GSCInlineString*)concat1
po concat1
memory read -f x -c 20 concat1
expr -O -- concat1
type summary add -s "GSCInlineString(_contents=<unknown type>, _count=6, _flags=...)" GSCInlineString
frame variable concat1
type summary clear GSCInlineString
frame variable concat1
quit