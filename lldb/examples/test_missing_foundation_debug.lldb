# LLDB script to test missing Foundation formatters
# Usage: lldb test_missing_foundation -s test_missing_foundation_debug.lldb

# Set breakpoint at main
b main
run

# Step through to create objects
c
process interrupt

# Test NSBundle
print "=== NSBundle Analysis ==="
frame variable mainBundle -T
memory read -c 20 -s 8 -fx `&mainBundle`
po mainBundle
print mainBundle

print "=== NSProcessInfo Analysis ==="
frame variable processInfo -T
memory read -c 20 -s 8 -fx `&processInfo`
po processInfo
print processInfo

print "=== NSUserDefaults Analysis ==="
frame variable standardDefaults -T
memory read -c 20 -s 8 -fx `&standardDefaults`
po standardDefaults  
print standardDefaults

print "=== NSLocale Analysis ==="
frame variable currentLocale -T
memory read -c 20 -s 8 -fx `&currentLocale`
po currentLocale
print currentLocale

print "=== NSScanner Analysis ==="
frame variable stringScanner -T
memory read -c 20 -s 8 -fx `&stringScanner`
po stringScanner
print stringScanner

# Test comparison with working formatter
print "=== TestObject for comparison ==="
frame variable testObj -T
po testObj
print testObj

quit