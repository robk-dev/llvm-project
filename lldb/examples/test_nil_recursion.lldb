file test_array_nil_recursion

# Set breakpoint after arrays are created
breakpoint set --file test_array_nil_recursion.m --line 18

run

# Test the arrays that were causing infinite recursion
frame variable arrayWithNils
frame variable emptyArray 
frame variable nullArray
frame variable arrayWithOneNil
frame variable mixedArray

# Test individual elements that might cause recursion
frame variable arrayWithNils[0]
frame variable arrayWithNils[1] 
frame variable arrayWithNils[2]
frame variable arrayWithOneNil[0]
frame variable mixedArray[2]

# Test hover simulation by trying to get summaries
type summary list NSArray
type summary list NSMutableArray

quit