#!/usr/bin/env lldb -S
# Test script for NSTimeInterval formatter validation

file test_nstime_interval
breakpoint set -f test_nstime_interval.m -l 40
run

# Test NSTimeInterval formatting
print timestamp1
print timestamp2
print duration1
print duration2
print duration3
print duration4
print duration5
print negative_duration
print zero_duration
print nan_value
print inf_value
print neg_inf_value

# Test with po command (should show formatted output)
po timestamp1
po timestamp2
po duration1
po duration2
po duration3
po duration4
po duration5
po negative_duration
po zero_duration
po nan_value
po inf_value
po neg_inf_value

# Test frame variables (should show all formatted at once)
frame variable timestamp1 timestamp2 duration1 duration2 duration3 duration4 duration5 negative_duration zero_duration nan_value inf_value neg_inf_value

quit