#!/usr/bin/env lldb -s

# Test script for testing the hardcoded offset fixes
file simple_array_test

# Set breakpoint at line 25 where arrays are created
b simple_array_test.m:25

# Run the program
run

# Test the array formatters with the dynamic offset fixes
print stringArray
po stringArray
print emptyArray  
po emptyArray
print mutableArray
po mutableArray

# Test individual elements
print stringArray[0]
po stringArray[0]
print stringArray[1]
po stringArray[1]

# Test the count and display
print (int)[stringArray count]
print (int)[mutableArray count]

# Exit
quit