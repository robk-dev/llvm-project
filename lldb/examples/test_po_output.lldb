# Test po command output
break set -f test_po_formatting.m -l 10
run

# Test basic variable display
p str
po str

p arr  
po arr

p dict
po dict

p num
po num

# Try expression evaluation  
expr -l objc -- @"test literal"
po @"test literal"

expr -l objc -- @[@"a", @"b"]
po @[@"a", @"b"]

# Check if formatters are enabled
type category list
type category list gnustep

# Check specific formatters
type summary list NSString
type summary list NSArray

# Continue and quit
continue
quit