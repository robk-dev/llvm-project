# Test script for restored po functionality
file test_po_debug
target create test_po_debug

# Enable detailed logging to see what's happening
log enable lldb expr
log enable lldb process types

# Set breakpoint at our test location
b test_po_debug.m:21

# Run and test po commands
run

# Test basic po commands that should now work with expression evaluation
po string
po number  
po array
po dict

# Test fallback cases
po (void*)0  # Should handle null gracefully
po (void*)0x12345  # Should handle invalid addresses

# Test more complex expressions
expr [(id)string description]
expr [(id)array description]

# Continue and exit
continue
quit