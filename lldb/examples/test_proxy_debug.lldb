file test_proxy
breakpoint set --name main
run

# Test proxy objects at the debug breakpoint
breakpoint set --line 215

# Continue to the breakpoint
continue

# Test NSProxy formatter with different proxy types
print simpleProxy
print protocolProxy
print nilTargetProxy

# Test business object through proxy
print business

# Test proxy properties
print proxyDesc
print businessResult
print value

# Test memory layout and class information
memory read simpleProxy
memory read protocolProxy

# Test proxy class information
expr [simpleProxy class]
expr [protocolProxy class]

# Test target extraction (if available)
print simpleProxy->_target
print simpleProxy->_description
print protocolProxy->_target

continue
quit