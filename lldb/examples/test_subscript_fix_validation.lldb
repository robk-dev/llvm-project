# Test script to validate our subscript fix approach
file test_expression_evaluation_simple
breakpoint set --file test_expression_evaluation_simple.m --line 13
run

# First verify that basic functionality still works
po fruits  
po dict

# Test our target scenarios
echo "=== TESTING ARRAY SUBSCRIPT ==="
# This SHOULD work now if our fix is successful
expr po fruits[0]

# Test if expression evaluator can find our new method signatures
expr (id)[fruits respondsToSelector:@selector(objectAtIndexedSubscript:)]
expr (id)[fruits performSelector:@selector(objectAtIndex:) withObject:@(0)]

echo "=== TESTING DICTIONARY SUBSCRIPT ==="  
# This SHOULD work now if our fix is successful
expr po dict[@"name"]

# Test if expression evaluator can find our new method signatures
expr (id)[dict respondsToSelector:@selector(objectForKeyedSubscript:)]
expr (id)[dict performSelector:@selector(objectForKey:) withObject:@"name"]

echo "=== TESTING DIRECT METHOD CALLS ==="
# These should definitely work (existing functionality)
po [fruits objectAtIndex:0]
po [dict objectForKey:@"name"]

quit