# GNUstep Tagged Pointers Test - Working Features
# This script demonstrates the current working state of tagged pointer support

file ./custom_class_test
b custom_class_test.m:182
run

# TEST 1: Array summary works correctly
po fruits

# TEST 2: Synthetic children work correctly 
frame variable fruits

# TEST 3: Direct tagged pointer access works
po (id)0xc3c386cca000002c

# TEST 4: Tagged numbers work
po (id)0x151

# TEST 5: Try expression evaluation (this will show the problem)
po fruits[0]

quit