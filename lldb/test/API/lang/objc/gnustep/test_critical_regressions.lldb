# Critical Regression Tests for Known Formatter Issues
# Focus on specific bugs that have been identified and fixed
# Run with: lldb test_comprehensive_formatters -b -s test_critical_regressions.lldb

target create test_comprehensive_formatters
breakpoint set --line 301
run

echo "\n==========================================="
echo "CRITICAL REGRESSION TEST SUITE"
echo "Testing Known Issues and Validating Fixes"
echo "===========================================\n"

# ======================================
# REGRESSION TEST 1: Array String Elements
# Issue: Arrays showing <string> placeholders instead of actual values
# Root Cause: Element summary not being retrieved properly
# ======================================

echo "\n[TEST 1] Array String Element Display\n"
echo "Issue: Arrays showing <string> placeholders\n"

frame variable simpleArray
# PASS: (NSArray *) simpleArray = @[@"Apple", @"Banana", @"Cherry"]
# FAIL: (NSArray *) simpleArray = @[<string>, <string>, <string>]

frame variable simpleArray --depth 2
# PASS: Shows actual string values for each element
# FAIL: Shows <string> placeholders

expression simpleArray[0]
expression simpleArray[1]
# PASS: Each returns actual string value
# FAIL: Returns nil or error

echo "Validating array with numbers (should always work):"
frame variable numberArray
# Expected: @[@1, @2, @3, @4, @5]

echo "Validating mixed array:"
frame variable mixedArray
# PASS: @[@"String", @42, @YES, NSNull]
# FAIL: @[<string>, @42, @YES, NSNull]

# ======================================
# REGRESSION TEST 2: Dictionary Key Display
# Issue: Shows verbose [0].key/[0].value instead of key=value
# Root Cause: Child naming in GetChildAtIndex
# ======================================

echo "\n[TEST 2] Dictionary Key-Value Display\n"
echo "Issue: Verbose [0].key/[0].value format\n"

frame variable simpleDict
# PASS: @{@"name": @"John Doe", @"age": @30, @"active": @YES}
# FAIL: @{[0].key: @"name", [0].value: @"John Doe", ...}

frame variable simpleDict --depth 2
# PASS: Clean key-value expansion
# FAIL: Verbose indexed format

expression [simpleDict allKeys]
# Should return array of keys

expression [simpleDict objectForKey:@"name"]
# Should return @"John Doe"

# ======================================
# REGRESSION TEST 3: Nested Collections
# Issue: Tagged numbers not displaying correctly in nested structures
# Root Cause: Recursive formatter application
# ======================================

echo "\n[TEST 3] Nested Collection Display\n"
echo "Issue: Tagged numbers in nested collections\n"

frame variable dictWithArrays
# PASS: @{@"fruits": @[@"Apple", @"Banana", @"Cherry"], @"numbers": @[@1, @2, @3]}
# FAIL: @{@"fruits": @[<string>, <string>, <string>], @"numbers": @[@1, @2, @3]}

expression dictWithArrays[@"fruits"]
# Should return the fruits array with visible strings

expression dictWithArrays[@"numbers"]
# Should return the numbers array

frame variable arrayOfDicts
# PASS: Shows all dictionaries with proper key-value pairs
# FAIL: Shows dictionaries with verbose format

frame variable deeplyNested --depth 3
# Should show full hierarchy without placeholders

# ======================================
# REGRESSION TEST 4: Custom Class Introspection
# Issue: Custom classes not showing properties
# Root Cause: ISA lookup returning LLDB_INVALID_ADDRESS
# ======================================

echo "\n[TEST 4] Custom Class Property Display\n"
echo "Issue: Custom class properties not visible\n"

frame variable customObj
# PASS: Shows TestObject with name and value properties
# FAIL: Shows raw pointer or minimal info

po customObj
# PASS: TestObject(name=TestName, value=100)
# FAIL: Error or incomplete output

expression customObj.name
expression customObj.value
# Should return property values

frame variable customArray
# Should show array containing custom object with properties

# ======================================
# REGRESSION TEST 5: Performance Validation
# Issue: Formatters must complete in <50ms
# ======================================

echo "\n[TEST 5] Performance Validation\n"
echo "Requirement: All formatters <50ms\n"

script import time

echo "Testing large string formatting:"
script start = time.time()
frame variable longString --no-summary
script elapsed = (time.time() - start) * 1000
script print(f"Time: {elapsed:.2f}ms - {'PASS' if elapsed < 50 else 'FAIL'}")

echo "Testing deep nesting formatting:"
script start = time.time()
frame variable deeplyNested --no-summary
script elapsed = (time.time() - start) * 1000
script print(f"Time: {elapsed:.2f}ms - {'PASS' if elapsed < 50 else 'FAIL'}")

echo "Testing large array formatting:"
script start = time.time()
frame variable arrayOfArrays --no-summary
script elapsed = (time.time() - start) * 1000
script print(f"Time: {elapsed:.2f}ms - {'PASS' if elapsed < 50 else 'FAIL'}")

# ======================================
# REGRESSION TEST 6: Edge Cases
# ======================================

echo "\n[TEST 6] Edge Case Handling\n"

echo "Empty collections:"
frame variable emptyArray
# Expected: @[]
frame variable emptyDict
# Expected: @{}
frame variable emptySet
# Expected: [NSSet setWithObjects: count:0]

echo "Nil handling:"
frame variable nilString
# Expected: nil
frame variable arrayWithNil
# Should show NSNull properly

echo "Circular references:"
frame variable circularArray --depth 1
# Should not hang or crash

# ======================================
# REGRESSION TEST 7: Tagged Pointer Handling
# ======================================

echo "\n[TEST 7] Tagged Pointer Validation\n"

echo "Tagged strings:"
frame variable taggedString
# Expected: @"Hello"

echo "Tagged numbers:"
frame variable taggedInt
# Expected: 42
frame variable taggedBool
# Expected: YES
frame variable taggedFloat
# Expected: 3.14

echo "Tagged values in collections:"
expression @[@1, @2, @3]
# Should show all numbers properly

expression @{@"key": @42}
# Should show tagged number in dictionary

# ======================================
# FINAL VALIDATION
# ======================================

echo "\n==========================================="
echo "REGRESSION TEST RESULTS"
echo "===========================================\n"

echo "Critical Issues to Verify:"
echo "✓ Array string elements display actual values"
echo "✓ Dictionary shows clean key=value format"
echo "✓ Nested collections display correctly"
echo "✓ Tagged numbers work in all contexts"
echo "✓ Custom classes show properties"
echo "✓ Performance meets <50ms requirement"
echo "✓ No crashes or hangs on edge cases"

echo "\nIf all tests pass, formatters are production-ready."
echo "If any test fails, investigate the specific formatter.\n"

continue
quit