# Integration test for GNUstep formatters
# Enhanced version with comprehensive coverage
target create ./a.out
breakpoint set --line 105
run

echo "\n=== INTEGRATION TEST SUITE ===\n"

# Test string formatters
echo "\nString Formatters:"
frame variable emptyString
frame variable asciiString
frame variable taggedString
po emptyString
po asciiString
po taggedString

# Test number formatters
echo "\nNumber Formatters:"
frame variable intNumber
frame variable boolNumber
po intNumber
po boolNumber

# Test collection formatters - CRITICAL TESTS
echo "\nCollection Formatters:"
frame variable simpleArray
frame variable simpleDict
frame variable simpleSet
po simpleArray
po simpleDict
po simpleSet

# Validate array elements (regression test)
echo "\nArray Element Validation:"
expression simpleArray[0]
expression simpleArray[1]

# Validate dictionary keys (regression test)
echo "\nDictionary Key Validation:"
expression [simpleDict allKeys]
expression [simpleDict objectForKey:@"name"]

# Test custom class
echo "\nCustom Class:"
frame variable account
po account

# Test nested structures if present
echo "\nNested Structures:"
expression @{@"nested": simpleArray}
expression @[@{@"key": @"value"}, @{@"key2": @"value2"}]

# Performance check
echo "\nPerformance validation (<50ms expected)..."
script import time
script start = time.time()
frame variable simpleArray --depth 2
script print(f"Array formatting: {(time.time() - start)*1000:.2f}ms")

echo "\n=== TEST COMPLETE ===\n"
continue
quit
