{
  "formatters": {
    "NSString": {
      "description": "GNUstep NSString formatter tests",
      "test_file": "test_nsstring_formatter.m",
      "breakpoint": 72,
      "tests": [
        {
          "name": "constant_string",
          "variable": "constantString1",
          "expected": "@\"Hello, World!\"",
          "type": "NSConstantString"
        },
        {
          "name": "empty_string",
          "variable": "emptyConstant",
          "expected": "@\"\"",
          "type": "NSConstantString"
        },
        {
          "name": "mutable_string",
          "variable": "mutableString1",
          "expected": "@\"Initial content\"",
          "type": "NSMutableString"
        },
        {
          "name": "utf8_string",
          "variable": "utf8String",
          "expected_pattern": "@\"UTF-8 encoded string:.*αβγδε\"",
          "type": "NSString"
        },
        {
          "name": "unicode_emoji",
          "variable": "unicode",
          "expected_pattern": "@\"Unicode:.*你好世界.*🌍.*😊\"",
          "type": "NSString"
        },
        {
          "name": "special_chars",
          "variable": "specialChars",
          "expected_pattern": "@\"Special:.*\\\\n.*\\\\t.*\\\"quotes\\\".*'apostrophe'.*\\\\\\\\backslash\\\\\\\\\"",
          "type": "NSString"
        },
        {
          "name": "format_string",
          "variable": "formatString",
          "expected": "@\"Formatted: 42, test\"",
          "type": "NSString"
        },
        {
          "name": "nil_string",
          "variable": "nilString",
          "expected": "nil",
          "type": "nil"
        },
        {
          "name": "long_string_truncation",
          "variable": "immutableLong",
          "expected_pattern": "@\"Line 0:.*\\.\\.\\.\"",
          "max_length": 256,
          "type": "NSString"
        }
      ]
    },
    "NSNumber": {
      "description": "GNUstep NSNumber formatter tests",
      "test_file": "test_nsnumber_formatter.m",
      "breakpoint": 53,
      "tests": [
        {
          "name": "integer_positive",
          "variable": "intNumber",
          "expected": "42",
          "expected_with_type": "(int) 42",
          "type": "NSNumber"
        },
        {
          "name": "integer_negative",
          "variable": "negativeInt",
          "expected": "-100",
          "expected_with_type": "(int) -100",
          "type": "NSNumber"
        },
        {
          "name": "integer_zero",
          "variable": "zeroInt",
          "expected": "0",
          "expected_with_type": "(int) 0",
          "type": "NSNumber"
        },
        {
          "name": "bool_yes",
          "variable": "boolYes",
          "expected_any": ["YES", "true", "1"],
          "expected_with_type": "(BOOL) YES",
          "type": "NSNumber"
        },
        {
          "name": "bool_no",
          "variable": "boolNo",
          "expected_any": ["NO", "false", "0"],
          "expected_with_type": "(BOOL) NO",
          "type": "NSNumber"
        },
        {
          "name": "float",
          "variable": "floatNumber",
          "expected_pattern": "3\\.14\\d*",
          "expected_with_type_pattern": "\\(float\\) 3\\.14\\d*",
          "type": "NSNumber"
        },
        {
          "name": "double",
          "variable": "doubleNumber",
          "expected_pattern": "2\\.718\\d*",
          "expected_with_type_pattern": "\\(double\\) 2\\.718\\d*",
          "type": "NSNumber"
        },
        {
          "name": "nan",
          "variable": "nanDouble",
          "expected_any": ["NaN", "nan"],
          "type": "NSNumber"
        },
        {
          "name": "infinity",
          "variable": "infDouble",
          "expected_any": ["inf", "Inf", "INFINITY", "+inf"],
          "type": "NSNumber"
        },
        {
          "name": "negative_infinity",
          "variable": "negInfDouble",
          "expected_any": ["-inf", "-Inf", "-INFINITY"],
          "type": "NSNumber"
        },
        {
          "name": "longlong_max",
          "variable": "longLongNumber",
          "expected": "9223372036854775807",
          "type": "NSNumber"
        },
        {
          "name": "ulonglong_max",
          "variable": "unsignedLongLong",
          "expected": "18446744073709551615",
          "type": "NSNumber"
        }
      ]
    },
    "NSArray": {
      "description": "GNUstep NSArray formatter tests",
      "test_file": "simple_array_test.m",
      "breakpoint": 25,
      "tests": [
        {
          "name": "empty_array",
          "variable": "emptyArray",
          "expected": "()",
          "expected_alternatives": ["@()", "[]", "{ }"],
          "type": "NSArray"
        },
        {
          "name": "string_array",
          "variable": "stringArray",
          "expected": "(\\n    @\"First\",\\n    @\"Second\",\\n    @\"Third\"\\n)",
          "expected_compact": "(@\"First\", @\"Second\", @\"Third\")",
          "expected_pattern": "\\(.*First.*Second.*Third.*\\)",
          "count": 3,
          "type": "NSArray"
        },
        {
          "name": "mutable_array",
          "variable": "mutableArray",
          "expected_pattern": "\\(.*Apple.*Banana.*Cherry.*Date.*Elderberry.*\\)",
          "count": 5,
          "type": "NSMutableArray"
        },
        {
          "name": "array_count_display",
          "variable": "stringArray",
          "command": "p",
          "expected_pattern": "3 (elements|objects)",
          "type": "NSArray"
        }
      ]
    },
    "NSDictionary": {
      "description": "GNUstep NSDictionary formatter tests (future)",
      "test_file": "test_nsdictionary_formatter.m",
      "breakpoint": 50,
      "tests": [
        {
          "name": "empty_dict",
          "variable": "emptyDict",
          "expected": "{}",
          "type": "NSDictionary"
        },
        {
          "name": "string_dict",
          "variable": "stringDict",
          "expected_pattern": "\\{.*key1.*=.*value1.*key2.*=.*value2.*\\}",
          "count": 2,
          "type": "NSDictionary"
        }
      ]
    },
    "NSSet": {
      "description": "GNUstep NSSet formatter tests (future)",
      "test_file": "test_nsset_formatter.m",
      "breakpoint": 30,
      "tests": [
        {
          "name": "empty_set",
          "variable": "emptySet",
          "expected": "{}",
          "expected_alternatives": ["{}", "NSSet()"],
          "type": "NSSet"
        },
        {
          "name": "string_set",
          "variable": "stringSet",
          "expected_pattern": "\\{.*One.*Two.*Three.*\\}",
          "count": 3,
          "type": "NSSet"
        }
      ]
    }
  },
  "test_settings": {
    "lldb_timeout": 30,
    "build_timeout": 60,
    "max_output_length": 4096,
    "truncation_marker": "...",
    "verbose_failures": true
  },
  "expected_behaviors": {
    "nil_handling": {
      "NSString": "nil",
      "NSNumber": "nil",
      "NSArray": "nil",
      "NSDictionary": "nil",
      "NSSet": "nil"
    },
    "empty_collections": {
      "NSArray": "()",
      "NSDictionary": "{}",
      "NSSet": "{}"
    },
    "large_collections": {
      "truncate_at": 100,
      "show_count": true,
      "ellipsis": "... and N more"
    }
  }
}